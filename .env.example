# HDFC SmartGateway Configuration
HDFC_BASE_URL=https://smartgatewayuat.hdfcbank.com
HDFC_MERCHANT_ID=your_merchant_id
HDFC_API_KEY=your_api_key
HDFC_TIMEOUT=30
HDFC_MAX_RETRIES=3

# Database Configuration
# For Docker use:
DATABASE_URL=postgresql+psycopg2://postgres:your_password@db:5432/payments
# For local development use:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/payments

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Application Configuration
APP_NAME=HDFC Payment Gateway
ENVIRONMENT=development
DEBUG=false
RETURN_URL=http://localhost:8000/payment/return

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console
